# Composer dependencies (reinstall with: composer install)
/vendor/

# Uploaded files (don't commit student photos/QR codes)
/uploads/students/*
/qrcodes/*
/storage/sessions/*

# Keep the folders but not the files
!uploads/students/.gitkeep
!qrcodes/.gitkeep
!storage/sessions/.gitkeep

# Environment / sensitive config
# config/database.php is safe to commit — it reads from environment variables
# config/database.php

# Temp/test files
test_qr.php
uppass.php
genhash.php
config/attendance_system.sql

# OS files
.DS_Store
Thumbs.db
desktop.ini

# PHP error logs
*.log
error_log

# IDE files
.vscode/
.idea/
*.swp